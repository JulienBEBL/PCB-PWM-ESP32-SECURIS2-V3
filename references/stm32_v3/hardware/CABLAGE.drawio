<mxfile host="Claude Code" agent="Claude Code"><diagram id="cablage" name="Câblage externe"><mxGraphModel dx="1200" dy="980" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;PCB_PWM_SECURISE_V3 — schéma de câblage externe&lt;/b&gt; (v1, session 13). Bleu : domaine commande (GND). Rouge : domaine puissance isolé (GND_P). &lt;b&gt;Ne jamais relier GND et GND_P.&lt;/b&gt; Broche 1 des connecteurs JST : repère triangle / carré sur le PCB." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;CARTE&lt;/b&gt;&lt;br&gt;STM32G071 · relais K1 / K2 · barrière d'isolation" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#fafafa;strokeColor=#555;strokeWidth=3;verticalAlign=top;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="520" height="700" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=line;direction=south;strokeColor=#888;dashed=1;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="588" y="330" width="4" height="460" as="geometry"/></mxCell><mxCell id="c5" value="isolation" style="text;html=1;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="60" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;J1 · JST XH 4 pts (B4B-XH-A)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1  +5V  (alim carte)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2  GND&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;3  PWM  (1000–2000 µs)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;4  STATUS (drain ouvert)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="140" width="220" height="95" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;J12 · USB-C&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;câble USB-C ↔ PC&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;programmation + moniteur série&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#f4ecf7;strokeColor=#7d3c98;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="245" width="220" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SW1 RESET · SW2 BOOT&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Mode programmation :&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;BOOT maintenu + RESET&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#f4ecf7;strokeColor=#7d3c98;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="315" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;J9 · SWD 1×5 2,54&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 +3V3  2 SWDIO  3 SWCLK&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;4 NRST  5 GND&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;(recours : sonde ST-LINK)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="385" width="220" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;J10 · UART2 1×3 2,54&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 TX  2 RX  3 GND&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;(3,3 V, croiser TX/RX)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="475" width="220" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;J8 · Extension 1×6 2,54&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 +3V3_EXT&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2 EXT1  3 EXT2  4 EXT3&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;5 EXT4  6 GND&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="545" width="220" height="75" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;J11 · Maintenance 1×2&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 MAINT  2 GND (fermé = actif)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="630" width="220" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;J7 · Cavalier armement 1×2&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;capuchon JP1 posé = armé&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;retiré = aucune sortie possible&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="690" width="220" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;J4 · JST XH 6 pts · FC « rentré »&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 COM R1 (GND)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2 R1 NO   3 R1 NC&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;4 COM R2 (GND)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;5 R2 NO   6 R2 NC&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="615" y="140" width="220" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;J5 · JST XH 7 pts · FC « sorti »&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 COM S1 (GND)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2 S1 NO   3 S1 NC&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;4 COM S2 (GND)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;5 S2 NO   6 S2 NC&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;7 non câblé (détrompage)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#eaf2fb;strokeColor=#1f6fb2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="615" y="250" width="220" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;J2 · JST XH 2 pts · entrée 12 V&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 +12V   2 GND_P&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="615" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;J3 · JST PH 2 pts (2,0 mm) · vérin&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 VERIN_A → fil rouge (V+)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2 VERIN_B → fil noir (V−)&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="615" y="470" width="220" height="75" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;J6 · JST XH 3 pts · 5e contact&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 +12V_P&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;2 non câblé (détrompage)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;3 NO_FEED&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="615" y="555" width="220" height="85" as="geometry"/></mxCell><mxCell id="c19" value="Contrôleur externe&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(autopilote / récepteur) : 5 V, GND, sortie PWM ~50 Hz, entrée STATUS avec rappel haut&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="230" height="80" as="geometry"/></mxCell><mxCell id="c20" value="PC&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;Arduino IDE · STM32CubeProgrammer&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#7d3c98;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="230" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Sonde ST-LINK V2/V3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(optionnelle, recommandée)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="230" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Adaptateur USB-série 3,3 V&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(optionnel, atelier)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="230" height="50" as="geometry"/></mxCell><mxCell id="c23" value="Capteurs d'extension&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(PO-07, à définir)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="230" height="60" as="geometry"/></mxCell><mxCell id="c24" value="Interrupteur / cavalier maintenance" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="230" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Fins de course « rentré »&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;2 microrupteurs inverseurs R1, R2 (COM / NO / NC), actionnés tige rentrée&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="250" height="100" as="geometry"/></mxCell><mxCell id="c26" value="Fins de course « sorti »&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;2 microrupteurs inverseurs S1, S2, actionnés tige sortie&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#1f6fb2;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="250" height="100" as="geometry"/></mxCell><mxCell id="c27" value="Source 12 V&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(isolée du 5 V, ≤ 13,5 V, PO-03)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="250" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Vérin Actuonix L12-…-12-S&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;rouge = V+, noir = V−. Repos des relais = rentrée&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="475" width="250" height="70" as="geometry"/></mxCell><mxCell id="c29" value="5e contact (arrêt matériel)&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;contact NC entre J6.1 et J6.3, ouvert en position d'action (DEC-029, PO-19)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="250" height="80" as="geometry"/></mxCell><mxCell id="c30" value="+5V · GND · PWM · STATUS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="USB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#7d3c98;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="SWD (5 fils)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c21" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="TX↔RX · GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c22" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="EXT1..4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c23" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="2 fils" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c24" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="6 fils" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="6 fils (pt 7 vide)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#1f6fb2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="+12V · GND_P" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#c0392b;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="2 fils moteur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#c0392b;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="2 fils (1 et 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#c0392b;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Règles de câblage&lt;/b&gt;&lt;br&gt;1. Détrompage : aucun connecteur externe n'a le même couple (série, nombre de points) : J2 (XH 2) ≠ J3 (PH 2) ; J4 (XH 6) ≠ J5 (XH 7) ; J6 (XH 3, centre vide) ≠ J3.&lt;br&gt;2. Programmation : 12 V débranché ou J7 retiré (relais au repos = le vérin rentre si le 12 V est présent). Procédure : &lt;i&gt;hardware/PROCEDURE_PROGRAMMATION.md&lt;/i&gt;.&lt;br&gt;3. La carte peut être alimentée par J1 ou par l'USB (diodes idéales, sans retour de courant).&lt;br&gt;4. Fins de course : chaque contact inverseur câblé COM + NO + NC (lecture antivalente, DEC-037). Contact sec, référence des microrupteurs à fournir (PO-23).&lt;br&gt;5. Brochage relais K1/K2 et polarité des diodes : à confirmer avant commande (rapport lot 3)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeColor=#999;fillColor=#fffbe6;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1160" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
